# SentinelSOC Environment Variables
# Copy this to .env and adjust as needed

DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_APP=app.py

# Database
DATABASE_PATH=database/security.db

# Threat Detection
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW=5
PASSWORD_SPRAY_THRESHOLD=3
UNUSUAL_LOGIN_START=8
UNUSUAL_LOGIN_END=20

# Application
LOG_LEVEL=INFO
